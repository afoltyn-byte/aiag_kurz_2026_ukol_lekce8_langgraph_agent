# Committed template. Copy to `.env` and fill in your own values:
#
#   cp .env.example .env
#   op run --env-file=.env -- python -m src.main "..."
#
# Each value can be either:
#
#   * a 1Password secret reference — `op://<vault>/<item>/<field>` — which `op run`
#     resolves into the environment of that one process, so no plaintext secret is ever
#     written to disk; or
#   * the value itself, if you are not using the 1Password CLI.
#
# Nothing in the Python code reads this file. The values simply have to be in the
# environment by the time a node looks for them, so `op run` and a plain exported shell
# variable are equally valid.
#
# `.env` is gitignored. Keep it that way.

# --- LLM provider: OpenAI -----------------------------------------------------
OPENAI_API_KEY=op://<vault>/<item>/credential

# --- Tavily MCP (analytics agent) ---------------------------------------------
# The key travels in an Authorization header, not in the URL.
TAVILY_API_KEY=op://<vault>/<item>/credential
# Endpoint override; unset means Tavily's hosted MCP server.
# TAVILY_MCP_URL=https://mcp.tavily.com/mcp/

# --- MT5 MCP server (trader agent) --------------------------------------------
# The URL is not a secret, just environment-scoped. Streamable HTTP on localhost — set
# the port your MT5 MCP server actually listens on.
MT5_MCP_URL=http://127.0.0.1:8000/mcp

# Optional. Leave unset for a local server that needs no auth — then no auth header is
# sent at all. When set, it goes out as `Authorization: Bearer <key>`; if your server
# wants a different shape, change MT5_AUTH_HEADER / MT5_AUTH_SCHEME in config.py.
# MT5_API_KEY=op://<vault>/<item>/credential

# --- Checkpointer -------------------------------------------------------------
# Leave unset for InMemorySaver (the default). Set for PostgresSaver, which is what makes
# a run suspended on a clarification survive a restart.
# POSTGRES_URI=op://<vault>/<item>/connection_string
